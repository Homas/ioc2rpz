{minimum_otp_vsn, "24.0"}.
{erl_opts, [debug_info]}.
{deps, [{cowboy, "2.12.0"}]}.

%% ranch and cowlib are transitive dependencies of cowboy and are not in the
%% default PLT, so calls into them (e.g. ranch:child_spec/5, used to supervise
%% the REST/DoH listeners) were reported as "Unknown function".
{dialyzer, [
    {plt_extra_apps, [cowboy, cowlib, ranch, inets, ssl, public_key, crypto]}
]}.

%% Kept: the checks that flag real defects - a call to a function that does not
%% exist anywhere, and calls into deprecated OTP APIs. `rebar3 xref' exits
%% non-zero on any finding, so it is usable as a CI gate only with the noisy
%% checks removed:
%%   * `exports_not_used'  - almost every hit is a false positive here (cowboy
%%     REST callbacks, supervisor/gen_server callbacks, and functions invoked as
%%     {M,F,A} from child specs or spawn_opt).
%%   * `locals_not_used'   - reports 11 pre-existing dead local functions (see
%%     "Dead code reported by xref" in TODO.md). Re-enable once those are cleaned
%%     up; until then it would keep CI permanently red.
%% Run `rebar3 xref --extra_checks="[locals_not_used, exports_not_used]"' to see
%% them on demand.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls
]}.

{shell, [
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args"},
    {apps, [ioc2rpz]}
]}.


{relx, [
  {release, {ioc2rpz, {cmd, "grep ioc2rpz_ver include/ioc2rpz.hrl | awk -F'\"' '{printf $2}'"}}, [ioc2rpz]},

  {dev_mode, true},
  {include_erts, false},
  {sys_config_src, "config/sys.config.src"},
  {vm_args_src, "config/vm.args"},

  {extended_start_script, true}
]}.
